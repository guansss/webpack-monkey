{
  "name": "webpack-monkey",
  "version": "0.2.1",
  "description": "Webpack plugin for developing userscripts with a modern workflow.",
  "scripts": {
    "playground": "webpack serve --config=playground/webpack.config.ts",
    "playground:build": "webpack --config=playground/webpack.config.ts",
    "clean": "rimraf -g ./dist/*",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsx scripts/postbuild.ts",
    "lint": "prettier --check .",
    "fmt": "prettier --write .",
    "examples": "tsx scripts/update-examples.ts",
    "examples:remote": "tsx scripts/update-examples.ts --remote",
    "test": "node --require tsx/cjs --test $(find tests -name '*.test.ts')",
    "test:u": "UPDATE_SNAPSHOTS=1 node --require tsx/cjs --test $(find tests -name '*.test.ts')",
    "test:coverage": "node --require tsx/cjs --experimental-test-coverage --test $(find tests -name '*.test.ts')",
    "test:browser:setup": "tsx tests/browser/setup.ts && playwright install chromium",
    "test:browser": "npm run test:browser:setup && playwright test",
    "prepare": "test -n \"$CI\" || npm run build"
  },
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guansss/webpack-monkey.git"
  },
  "author": "Guan",
  "license": "MIT",
  "homepage": "https://github.com/guansss/webpack-monkey#readme",
  "peerDependencies": {
    "colorette": "^2.0.20",
    "prettier": "^3.0.0",
    "webpack": "^5.0.0",
    "webpack-dev-server": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "colorette": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "dependencies": {
    "browser-extension-url-match": "^1.0.0",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "terser-webpack-plugin": "^5.6.0",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/lodash": "^4.17.0",
    "@typescript/typescript6": "^6.0.2",
    "css-loader": "^7.1.0",
    "glob": "^13.0.0",
    "jszip": "^3.10.2",
    "mini-css-extract-plugin": "^2.10.0",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^11.3.0",
    "prettier": "^3.9.0",
    "rimraf": "^6.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.0",
    "tsx": "^4.23.0",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.0",
    "webpack-dev-server": "^5.2.0"
  },
  "workspaces": [
    "examples/*"
  ]
}
